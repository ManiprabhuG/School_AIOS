# ===========================================
# ABS School Management ERP – Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# Database (PostgreSQL – Neon / Supabase / Railway)
DATABASE_URL="postgresql://user:password@host:5432/abs_school_erp?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.vercel.app"

# JWT Authentication
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis (Upstash recommended for Vercel)
REDIS_URL="redis://default:password@host:port"

# Cloudinary (File & Image Uploads)
CLOUDINARY_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# SMTP Email (Fee receipts, OTP, announcements)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="noreply@absschool.edu.in"
SMTP_PASSWORD="your-app-specific-smtp-password"
SMTP_FROM="ABS School ERP <noreply@absschool.edu.in>"

# Application
APP_NAME="ABS School Management ERP"
APP_URL="https://your-app.vercel.app"
APP_ENV="production"

# SMS Gateway (Optional – Twilio / MSG91)
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="your-sid"
# TWILIO_AUTH_TOKEN="your-token"
# TWILIO_FROM_NUMBER="+1234567890"
