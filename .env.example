# ABS School Management ERP Environment Configuration

# Rate Limiting Configuration
AUTH_RATE_LIMIT=5
PUBLIC_RATE_LIMIT=30
USER_RATE_LIMIT=100
RATE_LIMIT_WINDOW=60000 # Window size in milliseconds (1 minute)
EXPONENTIAL_BACKOFF=true

# Application Environment & Security
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="ABS School Management ERP"
JWT_SECRET=abs_school_erp_secure_jwt_secret_key_2026_change_in_prod

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Security
MAX_UPLOAD_SIZE_MB=5
ALLOWED_FILE_EXTENSIONS=.csv,.xlsx,.xls,.pdf,.jpg,.jpeg,.png
